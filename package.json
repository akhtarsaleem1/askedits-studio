{
  "name": "com.ask.askedits",
  "version": "2.4.0",
  "description": "Template-driven video editing studio with real FFmpeg exports, caption editing, and music mixing",
  "keywords": [
    "ask",
    "edits",
    "video",
    "upload",
    "editing",
    "ai",
    "ffmpeg",
    "react",
    "templates",
    "captions",
    "full-stack"
  ],
  "homepage": "https://github.com/akhtarsaleem1/askedits-studio#readme",
  "bugs": {
    "url": "https://github.com/akhtarsaleem1/askedits-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhtarsaleem1/askedits-studio.git"
  },
  "license": "ISC",
  "author": "ASK Envisionary, Akhtar Saleem Khan",
  "type": "module",
  "main": "src/backend/server.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "npm run dev:client:raw",
    "dev:client:raw": "vite",
    "dev:server": "npm run dev:server:raw",
    "dev:server:raw": "node --watch-path=src/backend --watch-path=config src/backend/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node src/backend/server.js",
    "test": "node --test tests/*.test.js",
    "test:media": "node scripts/test-media.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "setup:visuals": "node scripts/setup-visuals.mjs",
    "setup:matcher": "node scripts/setup-matcher.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "multer": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.62.1",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
