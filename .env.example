# No API credentials are needed to open the studio or run tests.
HOST=127.0.0.1
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
STORAGE_ROOT=storage/assets
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Optional local captions (Python 3.11+). Models download on first use.
# Manual captions and SRT import work without Python.
PYTHON_BIN=python
FASTER_WHISPER_MODEL=tiny
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
# Optional local presenter cutout: npm run setup:visuals, then restart.
# PERSON_SEGMENTATION_PACKAGES=storage/runtime/person-packages
# PERSON_SEGMENTATION_MODEL=storage/models/selfie_segmenter.tflite
GPU_ACCELERATION=false
# Optional providers for legacy modules; the template studio defaults to local speech.
# Never put keys in config/default.js.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional stock picker provider. Commons needs no key. Keep this server-side.
PEXELS_API_KEY=
PIXABAY_API_KEY=
AI_BROLL_ENABLED=false
REPLICATE_API_TOKEN=
