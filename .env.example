# No API credentials are needed to open the studio or run tests.
HOST=127.0.0.1
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
STORAGE_ROOT=storage/assets
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Optional local speech/vision pipeline (Python 3.11+)
PYTHON_BIN=python
FASTER_WHISPER_MODEL=tiny
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
GPU_ACCELERATION=false
# Optional cloud providers. Never put keys in config/default.js.
GROQ_API_KEY=
OPENROUTER_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
AI_BROLL_ENABLED=false
REPLICATE_API_TOKEN=
